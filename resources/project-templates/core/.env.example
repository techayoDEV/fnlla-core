APP_NAME="{{APP_NAME}}"
APP_ENV=development
APP_DEBUG=false
APP_URL=
ASSET_URL=
APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=
DB_PASSWORD=
# Set SESSION_SECURE=true when deploying behind HTTPS.
QUEUE_CONNECTION=file
QUEUE_PATH=framework/queue
QUEUE_MAX_ATTEMPTS=2
QUEUE_RETRY_BACKOFF_SECONDS=30
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_WORKER_MAX_SECONDS=300
QUEUE_IDEMPOTENCY_TTL_SECONDS=86400
# none, organization or custom. Multi-tenant modes deny scoped work when the
# authenticated server-side identity does not resolve an authorized tenant.
TENANCY_MODE=none
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_RETENTION_DAYS=90
AUDIT_MAXIMUM_ENTRIES=10000
