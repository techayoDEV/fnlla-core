{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fnlla.com/schemas/fnlla.product-validation-report.v1.schema.json",
  "title": "FNLLA Product Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "valid", "input_schema", "product_id", "runtime_evidence", "summary", "missing_module_manifests", "errors", "warnings"],
  "properties": {
    "schema": {"const": "fnlla.product-validation-report.v1"},
    "valid": {"type": "boolean"},
    "input_schema": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "runtime_evidence": {"const": "not_evaluated"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "declared_modules", "module_manifests"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "declared_modules": {"type": "integer", "minimum": 0},
        "module_manifests": {"type": "integer", "minimum": 0}
      }
    },
    "missing_module_manifests": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "path", "message"],
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string"},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
